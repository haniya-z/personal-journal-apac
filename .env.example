# =====================================================================
# Server-Side Configuration (Never exposed to the browser)
# =====================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (Roadmaps, Mentor Advice, Reality Check, Chat).
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Port for the Node.js Express server (defaults to 3000)
PORT=3000

# Server environment (development or production)
NODE_ENV=development

# Firebase Admin SDK Project ID
FIREBASE_PROJECT_ID=

# Base application URL (used for OAuth callbacks and links)
APP_URL=http://localhost:3000

# =====================================================================
# Client-Side Configuration (Exposed to Vite browser client via VITE_)
# =====================================================================

# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=

# Google OAuth 2.0 Client ID (for Google Calendar Reality Check sync)
VITE_GOOGLE_OAUTH_CLIENT_ID=
